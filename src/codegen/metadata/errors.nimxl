    </error>
    <error>
      <code category="NI SLSC Error" code="-250857" needsReview="no" symbol="kErrorRegisterNotFound"/>
      <desc><![CDATA[The specified register was not found. This usually indicates that the register is not supported by the SLSC device.]]></desc>
    </error>
