    </error>
    <error>
      <code category="NI SLSC Error" code="-250892" needsReview="no" symbol="kErrorPowerOnHoursNotTracking"/>
      <desc><![CDATA[The chassis is not tracking power-on hours due to corrupted storage. Please write an initial value to this property in order to resume the tracking.]]></desc>
    </error>
