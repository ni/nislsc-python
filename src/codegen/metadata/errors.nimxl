    </error>
    <error>
      <code category="NI SLSC Error" code="-250879" needsReview="no" symbol="kErrorCapsHardwareMismatch"/>
      <desc><![CDATA[Capabilities do not match the specified hardware.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250880" needsReview="no" symbol="kErrorCapsRuleFailure"/>
      <desc><![CDATA[The input caps failed JSON rule validation.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250881" needsReview="no" symbol="kErrorEventNotFound"/>
      <desc><![CDATA[The specified event was not found. This usually indicates that the event is not supported by the device or physical channel.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250882" needsReview="no" symbol="kErrorInvalidEventName"/>
      <desc><![CDATA[The specified event name is invalid. Event names may consist of multiple identifiers separated by periods. For example, "SomeVendor.Load.TemperatureFault" is a valid event name.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250883" needsReview="no" symbol="kErrorVariantDataTypeMismatch"/>
