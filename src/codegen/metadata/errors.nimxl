      <code category="NI SLSC Error" code="-250848" needsReview="no" symbol="kErrorMdnsDiscoveryInProgress"/>
      <desc><![CDATA[mDNS discovery is in progress, but it is not complete. Try again later.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250849" needsReview="no" symbol="kErrorMdnsFailure"/>
      <desc><![CDATA[Failed to connect to the mDNS service. Ensure the NI mDNS Responder Service is running.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250850" needsReview="no" symbol="kErrorPhysicalChannelNotFound"/>
      <desc><![CDATA[The specified physical channel was not found. This usually indicates that the physical channel is not supported by the SLSC device.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250851" needsReview="no" symbol="kErrorInvalidPhysicalChannelName"/>
      <desc><![CDATA[The specified physical channel name is invalid. Physical channel names are of the form <device name>/<physical channel name>. For example, "Mod1/load0" is a valid physical channel name.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250852" needsReview="no" symbol="kErrorAuthenticationFailure"/>
      <desc><![CDATA[The operation failed due to an authentication failure. Check that you are using the correct login credentials for this SLSC device.]]></desc>
