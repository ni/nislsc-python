    </error>
    <error>
      <code category="NI SLSC Error" code="-250885" needsReview="no" symbol="kErrorAliasNotSupported"/>
      <desc><![CDATA[The specified alias is not supported in this situation. The VI/function may not support this alias, or the VI/function may require you to specify this alias separately from other resource names, not as part of a comma-delimited list.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250886" needsReview="no" symbol="kErrorPropertyValueOutOfRange"/>
      <desc><![CDATA[The property value is outside of the range of the property data type.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250887" needsReview="no" symbol="kErrorChassisFanFault"/>
      <desc><![CDATA[A chassis fan fault condition was detected. This might result in overheating chassis/modules and software malfunction.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250888" needsReview="no" symbol="kErrorEnumNotFound"/>
      <desc><![CDATA[The specified enum was not found.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250889" needsReview="no" symbol="kErrorDeviceCapabilitiesTooNew"/>
      <desc><![CDATA[The device capabilities are too new to be used by this version of NI-SLSC. Update the SLSC driver and firmware or obtain a compatible capabilities file from the module vendor.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250890" needsReview="no" symbol="kErrorChassisFirmwareTooNew"/>
      <desc><![CDATA[The SLSC chassis firmware is newer than the NI-SLSC driver. Upgrade the driver or downgrade the firmware to use the chassis.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250891" needsReview="no" symbol="kErrorChassisFirmwareTooOld"/>
