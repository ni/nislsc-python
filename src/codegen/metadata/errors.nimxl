<?xml version='1.0' encoding='utf-8'?>
<dict>
  <metadata>
    <product>NI SLSC</product>
    <comment>Errors for SLSC</comment>
    <fra>0</fra>
    <jpn>0</jpn>
    <eng>1</eng>
    <deu>0</deu>
    <chs>0</chs>
    <kor>0</kor>
  </metadata>
  <configuration>
    <range>
      <!-- Errors -->
      <minimum>-250999</minimum>
      <maximum>-250800</maximum>
    </range>
    <range>
      <!-- Warnings -->
      <minimum>250800</minimum>
      <maximum>250999</maximum>
    </range>
  </configuration>
  <descriptions>
    <error>
      <code category="NI SLSC Warning" code="250800" needsReview="no" symbol="kWarningScalingTimestampOutdated"/>
      <desc><![CDATA[Current scaling change timestamp is earlier than previously stored Last Scaling Change. Possible reason: the time of specified SLSC chassis is not accurate. Use the Get and Set Chassis Time and Time zone VI, available at labview\examples\slsc, to synchronize the time between the SLSC chassis and the host.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250800" needsReview="no" symbol="kErrorInternal"/>
      <desc><![CDATA[An internal software error occurred in NI-SLSC. Contact National Instruments Technical Support at ni.com/support.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250801" needsReview="no" symbol="kErrorOutOfMemory"/>
      <desc><![CDATA[The requested memory could not be allocated.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250802" needsReview="no" symbol="kErrorInvalidParameter"/>
      <desc><![CDATA[The operation failed because a parameter value is invalid.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250803" needsReview="no" symbol="kErrorInvalidPointer"/>
      <desc><![CDATA[The operation failed because a pointer-type parameter is invalid.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250804" needsReview="no" symbol="kErrorOSFault"/>
      <desc><![CDATA[An unexpected operating system error occurred.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250805" needsReview="no" symbol="kErrorBufferTooSmall"/>
      <desc><![CDATA[The specified buffer size is too small for the result.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250806" needsReview="no" symbol="kErrorDeviceNotFound"/>
      <desc><![CDATA[The specified SLSC device was not found.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250807" needsReview="no" symbol="kErrorInvalidDeviceName"/>
      <desc><![CDATA[The specified SLSC device name is invalid. Device names cannot be empty and length cannot exceed 63 characters. Device names may consist of the letters 'a'-'z' (case-insensitive), the digits '0'-'9', and the hyphen ('-'). Device names must contain at least one non-numeric character, and may not begin or end with a hyphen.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250808" needsReview="no" symbol="kErrorDeviceNameConflict"/>
      <desc><![CDATA[The specified SLSC device name conflicts with another device name.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250809" needsReview="no" symbol="kErrorDeviceNotConnected"/>
      <desc><![CDATA[The session does not have a network connection for the specified SLSC device.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250810" needsReview="no" symbol="kErrorDeviceNotReserved"/>
      <desc><![CDATA[The specified SLSC device is not reserved by this session.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250811" needsReview="no" symbol="kErrorDeviceReservedByAnotherSession"/>
      <desc><![CDATA[The operation cannot be performed because the SLSC device is reserved by another session.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250812" needsReview="no" symbol="kErrorDeviceNotSlscChassis"/>
      <desc><![CDATA[The specified device is not an SLSC chassis.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250813" needsReview="no" symbol="kErrorDeviceNotSlscModule"/>
      <desc><![CDATA[The specified device is not an SLSC module.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250814" needsReview="no" symbol="kErrorPropertyNotFound"/>
      <desc><![CDATA[The specified property was not found. This usually indicates that the property is not supported by the SLSC device or physical channel.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250815" needsReview="no" symbol="kErrorInvalidPropertyName"/>
      <desc><![CDATA[The specified property name is invalid. Property names may consist of multiple identifiers separated by periods. For example, "SomeVendor.Load.Resistance" is a valid property name.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250816" needsReview="no" symbol="kErrorInvalidPropertyValue"/>
      <desc><![CDATA[The specified property value is invalid.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250817" needsReview="no" symbol="kErrorPropertyNotReadable"/>
      <desc><![CDATA[The specified property is not readable.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250818" needsReview="no" symbol="kErrorPropertyNotWritable"/>
      <desc><![CDATA[The specified property is not writable.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250819" needsReview="no" symbol="kErrorPropertyDataTypeMismatch"/>
      <desc><![CDATA[The data type of the specified property does not match the data type of the property value.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250820" needsReview="no" symbol="kErrorPropertyArrayLength"/>
      <desc><![CDATA[The number of property values does not match the number of resource names.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250821" needsReview="no" symbol="kErrorReadingPropertyWithUncommittedChange"/>
      <desc><![CDATA[The specified property cannot be read because it has an uncommitted change that needs to be committed or reverted.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250822" needsReview="no" symbol="kErrorInvalidPropertyForNonEnum"/>
      <desc><![CDATA[The specified property is valid only for enum properties.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250823" needsReview="no" symbol="kErrorInvalidConfigFile"/>
      <desc><![CDATA[The contents of the configuration file are invalid.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250824" needsReview="no" symbol="kErrorFileIOFailure"/>
      <desc><![CDATA[The operation failed due to a file I/O error.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250825" needsReview="no" symbol="kErrorFileNotFound"/>
      <desc><![CDATA[The operation failed because a required file was not found.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250826" needsReview="no" symbol="kErrorFileAccessDenied"/>
      <desc><![CDATA[The operation failed because the user login does not have sufficient permissions to access a required file. Consider running as an administrator.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250827" needsReview="no" symbol="kErrorResourceNotFound"/>
      <desc><![CDATA[The specified resource was not found.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250828" needsReview="no" symbol="kErrorInvalidResourceName"/>
      <desc><![CDATA[The specified resource name is invalid.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250829" needsReview="no" symbol="kErrorTooManyNames"/>
      <desc><![CDATA[A single name is required, but multiple names were specified. Please specify a single name, not a comma-delimited list or colon-delimited range.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250830" needsReview="no" symbol="kErrorRepeatedName"/>
      <desc><![CDATA[A name was specified more than once in the same comma-delimited list. Please specify each name only once.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250831" needsReview="no" symbol="kErrorEmptyName"/>
      <desc><![CDATA[A name is required, but an empty string was specified.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250832" needsReview="no" symbol="kErrorInvalidUTF8String"/>
      <desc><![CDATA[The specified string is not valid UTF-8.]]></desc>
