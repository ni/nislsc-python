      <code category="NI SLSC Error" code="-250900" needsReview="no" symbol="kErrorDeviceAlreadyReservedBySameSession"/>
      <desc><![CDATA[The operation cannot be performed because the SLSC device is already reserved by the same session.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250901" needsReview="no" symbol="kErrorSessionNumUpToLimition"/>
      <desc><![CDATA[Maximum number of sessions reached. To create new sessions, you must close existing sessions.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250902" needsReview="no" symbol="kErrorIncorrectSerialNumber"/>
      <desc><![CDATA[The specified serial number does not match the hardware.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250903" needsReview="no" symbol="kErrorIncorrectNvmemPassword"/>
      <desc><![CDATA[The specified NVMEM password is incorrect.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250904" needsReview="no" symbol="kErrorRemoteChassisNotAdded"/>
      <desc><![CDATA[You are connecting to a remote chassis. You need to use the <b>Add Network Chassis VI</b> to add the chassis to the local configuration file before using the chassis.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250905" needsReview="no" symbol="kErrorNoAvailableSockets"/>
      <desc>
         <![CDATA[There are no available sockets in the Phar Lap ETS target. To increase the maximum number of sockets in the Phar Lap ETS target, add the following text to the <b>ni-rt.ini</b> file in the Phar Lap ETS target:

[TCP_Stack_Config]
Max_Sockets = n

n is the maximum number of sockets in the Phar Lap ETS target. The default maximum number of sockets in a Phar Lap ETS target is 256.]]>
    </desc>
    </error>
