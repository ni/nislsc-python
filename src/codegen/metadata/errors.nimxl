    </error>
    <error>
      <code category="NI SLSC Error" code="-250834" needsReview="no" symbol="kErrorSPICommunicationFault"/>
      <desc><![CDATA[An SPI communication fault on the SLSC backplane occurred.]]></desc>
    </error>
    <error>
      <code category="NI SLSC Error" code="-250835" needsReview="no" symbol="kErrorDllLoadFailure"/>
      <desc><![CDATA[A required DLL failed to load.]]></desc>
    </error>
    <error>
